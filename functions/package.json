{
  "name": "functions",
  "private": true,
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "ingest:wc2026": "npm run build && node ./scripts/ingest_wc2026.mjs",
    "enrich:crests": "npm run build && node ./scripts/enrich_team_crests.mjs",
    "test:mapping": "npm run build && node ./scripts/test_football_data_mapping.mjs",
    "test:crests": "npm run build && node ./scripts/test_team_crest_enrichment.mjs",
    "test:reconciliation": "npm run build && node ./scripts/test_group_match_reconciliation.mjs",
    "test:pot": "npm run build && node ./scripts/test_pot_math.mjs",
    "verify:sample": "npm run build && node ./scripts/verify_wc2026_sample.mjs",
    "verify:catalog": "node ./scripts/check_firestore_catalog.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}

